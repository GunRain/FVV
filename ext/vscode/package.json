{
  "name": "fvv",
  "displayName": "FVV Language",
  "description": "FVV Language for VS Code",
  "version": "0.0.1",
  "publisher": "TianwanAyana",
  "license": "F2DLPRL",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/OutOfMemories-WorkGroup/FVV.git"
  },
  "engines": {
    "vscode": "^0.10.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fvv",
        "aliases": [
          "FVV",
          "fvv",
          "FW",
          "fw",
          "RPP",
          "rpp",
          "R++",
          "r++",
          "RXX",
          "rxx",
          "RR",
          "rr"
        ],
        "extensions": [
          ".fvv",
          ".fw",
          ".rpp",
          ".r++",
          ".rxx",
          ".rr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fvv",
        "scopeName": "source.fvv",
        "path": "./syntaxes/fvv.tmLanguage.json"
      }
    ]
  }
}